<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:modeler="http://fluxnova.finos.org/schema/modeler/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:agent="http://fluxnova.finos.org/schema/1.0/ai/agent" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_123" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Fluxnova Modeler" exporterVersion="1.2.0-dev" modeler:executionPlatform="Fluxnova Platform" modeler:executionPlatformVersion="2.0.0">
  <bpmn:process id="LoanApprovalProcess_AI" name="Loan Approval Process" isExecutable="true" camunda:historyTimeToLive="40">
    <bpmn:startEvent id="StartEvent_1" name="Loan Application Submitted">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_1y6wy99</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_DocumentIntelligence" name="AI: Extract Data from Documents" camunda:type="external" camunda:topic="document-intelligence">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1" name="Automated Validation" default="SequenceFlow_3">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_FraudDetection" name="AI: Fraud Detection" camunda:type="external" camunda:topic="fraud-detection">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="Input_33ee9ip" />
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_2" name="Fraud Detected?" default="Flow_1qimgqg">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_1qimgqg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SubProcess_ComplianceReview" name="Compliance Review">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_1vkf6s8</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_2" name="Start Compliance Review">
        <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask_ComplianceCheck" name="AI: Compliance Check" camunda:type="external" camunda:topic="compliance-check">
        <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="UserTask_ComplianceReview" name="Human: Compliance Officer Review">
        <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_3" name="Compliance Cleared?" default="SequenceFlow_13">
        <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent_3" name="Compliance Cleared">
        <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="EndEvent_4" name="Compliance Rejected">
        <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_2" targetRef="ServiceTask_ComplianceCheck" />
      <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_ComplianceCheck" targetRef="UserTask_ComplianceReview" />
      <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="UserTask_ComplianceReview" targetRef="Gateway_3" />
      <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Gateway_3" targetRef="EndEvent_3">
        <bpmn:conditionExpression>${complianceStatus eq 'CLEARED'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Gateway_3" targetRef="EndEvent_4" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_4" name="Risk Approved?" default="SequenceFlow_18">
      <bpmn:incoming>Flow_0gphuwv</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_DynamicPricing" name="AI: Adjust Interest Rate" camunda:type="external" camunda:topic="adjust-interest-rate">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_5" name="Manual Review Required?" default="SequenceFlow_21">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_LoanOfficerReview" name="Human: Loan Officer Review" camunda:formRef="credit_approval_review" camunda:formRefBinding="latest">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_6" name="Approved?" default="SequenceFlow_24">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_23</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_GenerateAgreement" name="Generate Loan Agreement" camunda:type="external" camunda:topic="generate-loan-agreement">
      <bpmn:incoming>SequenceFlow_23</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_SendForESignature" name="Send for E-Signature" camunda:type="external" camunda:topic="send-for-e-signature">
      <bpmn:incoming>SequenceFlow_25</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_DisburseFunds" name="Disburse Funds" camunda:type="external" camunda:topic="disburse-fund">
      <bpmn:incoming>SequenceFlow_26</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Loan Approved">
      <bpmn:incoming>SequenceFlow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Loan_Rejected" name="Loan Rejected">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_DocumentIntelligence" />
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="ServiceTask_DocumentIntelligence" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="SequenceFlow_4" name="Invalid" sourceRef="Gateway_1" targetRef="EndEvent_Loan_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isInvalid eq true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="ServiceTask_FraudDetection" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="SequenceFlow_6" name="Yes" sourceRef="Gateway_2" targetRef="SubProcess_ComplianceReview">
      <bpmn:conditionExpression>${isFraudulent eq true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_17" name="Yes" sourceRef="Gateway_4" targetRef="ServiceTask_DynamicPricing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${aiRiskScore &lt;= 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_18" name="No" sourceRef="Gateway_4" targetRef="EndEvent_Loan_Rejected" />
    <bpmn:sequenceFlow id="SequenceFlow_19" sourceRef="ServiceTask_DynamicPricing" targetRef="Gateway_5" />
    <bpmn:sequenceFlow id="SequenceFlow_20" name="Yes" sourceRef="Gateway_5" targetRef="UserTask_LoanOfficerReview">
      <bpmn:conditionExpression>${approvalDecision eq 'MANUAL_REVIEW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_21" name="No" sourceRef="Gateway_5" targetRef="ServiceTask_GenerateAgreement" />
    <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="UserTask_LoanOfficerReview" targetRef="Gateway_6" />
    <bpmn:sequenceFlow id="SequenceFlow_23" name="Yes" sourceRef="Gateway_6" targetRef="ServiceTask_GenerateAgreement">
      <bpmn:conditionExpression>${loanOfficerDecision eq 'APPROVE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_24" name="No" sourceRef="Gateway_6" targetRef="EndEvent_Loan_Rejected" />
    <bpmn:sequenceFlow id="SequenceFlow_25" sourceRef="ServiceTask_GenerateAgreement" targetRef="ServiceTask_SendForESignature" />
    <bpmn:sequenceFlow id="SequenceFlow_26" sourceRef="ServiceTask_SendForESignature" targetRef="ServiceTask_DisburseFunds" />
    <bpmn:sequenceFlow id="SequenceFlow_27" sourceRef="ServiceTask_DisburseFunds" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="SequenceFlow_3" name="Valid" sourceRef="Gateway_1" targetRef="ServiceTask_FraudDetection" />
    <bpmn:task id="Activity_1q0ttb5" name="Store Documents">
      <bpmn:incoming>Flow_1y6wy99</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1y6wy99" sourceRef="StartEvent_1" targetRef="Activity_1q0ttb5" />
    <bpmn:adHocSubProcess id="AgentTask_CreditRisk" name="AI: Credit Risk Agent">
      <bpmn:extensionElements>
        <agent:config provider="${creditRiskAgentProvider}" model="${creditRiskAgentModel}" cacheStrategy="${creditRiskAgentCacheStrategy}" promptCacheKey="${creditRiskAgentPromptCacheKey}" systemPrompt="You are a senior loan assessment analyst. Your goal is to gather enough evidence to make a well-reasoned, defensible lending decision for each applicant by using the tools at your disposal." />
        <agent:context>
          <agent:variable name="requestedAmount" />
          <agent:variable name="loanPurpose" />
          <agent:variable name="creditScore" />
          <agent:variable name="annualIncome" />
          <agent:variable name="aiRiskScore" />
          <agent:variable name="employmentVerified" />
        </agent:context>
        <camunda:inputOutput>
          <camunda:outputParameter name="Output_3o127f8" />
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qimgqg</bpmn:incoming>
      <bpmn:outgoing>Flow_1qj012q</bpmn:outgoing>
      <bpmn:serviceTask id="ServiceTask_VerifyEmployment" name="Verify Employment" camunda:delegateExpression="${verifyEmploymentDelegate}">
        <bpmn:documentation>This service verifies the employment of an applicant</bpmn:documentation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="ServiceTask_CreditScoreCheck" name="Credit Score Check" camunda:delegateExpression="${checkCreditScoreDelegate}">
        <bpmn:documentation>This service checks the credit score of an applicant</bpmn:documentation>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_1qimgqg" sourceRef="Gateway_2" targetRef="AgentTask_CreditRisk" />
    <bpmn:sequenceFlow id="Flow_1qj012q" sourceRef="AgentTask_CreditRisk" targetRef="ServiceTask_EvaluateCreditScore" />
    <bpmn:endEvent id="Event_Loan_Rejected_By_Compliance" name="Loan Rejected by Compliance">
      <bpmn:incoming>Flow_1vkf6s8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1vkf6s8" sourceRef="SubProcess_ComplianceReview" targetRef="Event_Loan_Rejected_By_Compliance" />
    <bpmn:serviceTask id="ServiceTask_EvaluateCreditScore" name="Evaluate Credit Score and AI Risk" camunda:type="external" camunda:topic="evaluate-credit-risk">
      <bpmn:documentation>This service evaluates the credit score and ai risk to give a final decision</bpmn:documentation>
      <bpmn:incoming>Flow_1qj012q</bpmn:incoming>
      <bpmn:outgoing>Flow_0gphuwv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0gphuwv" sourceRef="ServiceTask_EvaluateCreditScore" targetRef="Gateway_4" />
    <bpmn:textAnnotation id="TextAnnotation_0o2m9rc">
      <bpmn:text>Credit risk assessment agent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_07relqk" associationDirection="None" sourceRef="AgentTask_CreditRisk" targetRef="TextAnnotation_0o2m9rc" />
    <bpmn:textAnnotation id="TextAnnotation_1y46zec">
      <bpmn:text>Connect to the fraud detection agent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_14d4mn6" associationDirection="None" sourceRef="ServiceTask_FraudDetection" targetRef="TextAnnotation_1y46zec" />
    <bpmn:textAnnotation id="TextAnnotation_0o9oac2">
      <bpmn:text>Connect to the document processing agent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1qib9ly" associationDirection="None" sourceRef="ServiceTask_DocumentIntelligence" targetRef="TextAnnotation_0o9oac2" />
  </bpmn:process>
