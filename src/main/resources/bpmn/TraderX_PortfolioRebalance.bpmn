<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://finos.org/demo/traderx">
<bpmn:process id="TraderX_PortfolioRebalance" name="Portfolio rebalance" isExecutable="true" camunda:historyTimeToLive="40">
<bpmn:startEvent id="Start" name="Request submitted">
<bpmn:outgoing>s1</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:userTask id="Review" name="Human approval">
<bpmn:incoming>s1</bpmn:incoming>
<bpmn:outgoing>s2</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="Approved" name="Approved?" default="no">
<bpmn:incoming>s2</bpmn:incoming>
<bpmn:outgoing>yes</bpmn:outgoing>
<bpmn:outgoing>no</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="Execute" name="Submit next approved basket order" camunda:delegateExpression="${traderXRebalanceExecution}" camunda:asyncBefore="true" camunda:exclusive="true">
<bpmn:extensionElements><camunda:failedJobRetryTimeCycle>R0/PT1M</camunda:failedJobRetryTimeCycle></bpmn:extensionElements>
<bpmn:incoming>yes</bpmn:incoming>
<bpmn:incoming>more</bpmn:incoming>
<bpmn:outgoing>s3</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="Outcome" name="API success?" default="failed">
<bpmn:incoming>s3</bpmn:incoming>
<bpmn:outgoing>ok</bpmn:outgoing>
<bpmn:outgoing>more</bpmn:outgoing>
<bpmn:outgoing>failed</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="Done" name="Recorded">
<bpmn:incoming>ok</bpmn:incoming>
</bpmn:endEvent>
<bpmn:endEvent id="Rejected" name="Rejected">
<bpmn:incoming>no</bpmn:incoming>
</bpmn:endEvent>
<bpmn:userTask id="Reconcile" name="Operations reconciliation">
<bpmn:incoming>failed</bpmn:incoming>
</bpmn:userTask>
<bpmn:sequenceFlow id="s1" sourceRef="Start" targetRef="Review">
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="s2" sourceRef="Review" targetRef="Approved">
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="yes" sourceRef="Approved" targetRef="Execute">
<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="no" sourceRef="Approved" targetRef="Rejected">
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="s3" sourceRef="Execute" targetRef="Outcome">
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="ok" sourceRef="Outcome" targetRef="Done">
<bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${externalSuccess == true &amp;&amp; batchIndex >= batchSize}</bpmn:conditionExpression>
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="failed" sourceRef="Outcome" targetRef="Reconcile">
</bpmn:sequenceFlow>
<bpmn:sequenceFlow id="more" name="Next item" sourceRef="Outcome" targetRef="Execute"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${externalSuccess == true &amp;&amp; batchIndex &lt; batchSize}</bpmn:conditionExpression></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_TraderX_PortfolioRebalance"><bpmndi:BPMNPlane id="Plane_TraderX_PortfolioRebalance" bpmnElement="TraderX_PortfolioRebalance">
<bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="80" y="160" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Review" bpmnElement="Review"><dc:Bounds x="160" y="138" width="150" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Approved" bpmnElement="Approved"><dc:Bounds x="355" y="153" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Execute" bpmnElement="Execute"><dc:Bounds x="450" y="138" width="190" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Outcome" bpmnElement="Outcome"><dc:Bounds x="685" y="153" width="50" height="50"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Done" bpmnElement="Done"><dc:Bounds x="800" y="160" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Rejected" bpmnElement="Rejected"><dc:Bounds x="360" y="320" width="36" height="36"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Shape_Reconcile" bpmnElement="Reconcile"><dc:Bounds x="660" y="300" width="190" height="80"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Edge_s1" bpmnElement="s1"><di:waypoint x="116" y="178.0"/><di:waypoint x="160" y="178.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_s2" bpmnElement="s2"><di:waypoint x="310" y="178.0"/><di:waypoint x="355" y="178.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_yes" bpmnElement="yes"><di:waypoint x="405" y="178.0"/><di:waypoint x="450" y="178.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_no" bpmnElement="no"><di:waypoint x="380.0" y="203"/><di:waypoint x="380.0" y="338.0"/><di:waypoint x="360" y="338.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_s3" bpmnElement="s3"><di:waypoint x="640" y="178.0"/><di:waypoint x="685" y="178.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_ok" bpmnElement="ok"><di:waypoint x="735" y="178.0"/><di:waypoint x="800" y="178.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_failed" bpmnElement="failed"><di:waypoint x="710.0" y="203"/><di:waypoint x="710.0" y="340.0"/><di:waypoint x="660" y="340.0"/></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Edge_more" bpmnElement="more"><di:waypoint x="710" y="153"/><di:waypoint x="710" y="80"/><di:waypoint x="545" y="80"/><di:waypoint x="545" y="138"/></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
