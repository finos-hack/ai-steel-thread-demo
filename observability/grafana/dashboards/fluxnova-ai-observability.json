{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "mi-4 AI System Observability",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(fluxnova_llm_calls_total{workflow=~\"$workflow\", task=~\"$agent_task\", status=\"success\"})",
          "legendFormat": "success",
          "refId": "A"
        }
      ],
      "title": "Successful LLM calls",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(fluxnova_llm_errors_total{workflow=~\"$workflow\", task=~\"$agent_task\"}) or vector(0)",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "title": "LLM errors",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fluxnova_llm_duration_seconds_bucket{workflow=~\"$workflow\", task=~\"$agent_task\"}[$__rate_interval]))) * 1000",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "LLM latency p95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum(fluxnova_dlp_mi1_egress_total) or vector(0)",
          "legendFormat": "egress",
          "refId": "A"
        }
      ],
      "title": "mi-1 DLP egress events",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (task) (rate(fluxnova_llm_duration_seconds_sum{workflow=~\"$workflow\", task=~\"$agent_task\"}[$__rate_interval])) / clamp_min(sum by (task) (rate(fluxnova_llm_duration_seconds_count{workflow=~\"$workflow\", task=~\"$agent_task\"}[$__rate_interval])), 1e-9) * 1000",
          "legendFormat": "{{task}}",
          "refId": "A"
        }
      ],
      "title": "Mean LLM latency by task",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (task, status) (rate(fluxnova_llm_calls_total{workflow=~\"$workflow\", task=~\"$agent_task\"}[$__rate_interval]))",
          "legendFormat": "{{task}} · {{status}}",
          "refId": "A"
        }
      ],
      "title": "LLM call rate by status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (token_type) (increase(fluxnova_llm_tokens_total{workflow=~\"$workflow\", task=~\"$agent_task\"}[5m]))",
          "legendFormat": "{{token_type}}",
          "refId": "A"
        }
      ],
      "title": "Token usage (5m increase)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(fluxnova_llm_errors_total{workflow=~\"$workflow\", task=~\"$agent_task\"}[$__rate_interval]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        },
        {
          "expr": "sum by (outcome) (rate(fluxnova_dlp_mi1_egress_total[$__rate_interval]))",
          "legendFormat": "dlp {{outcome}}",
          "refId": "B"
        }
      ],
      "title": "LLM errors & DLP egress rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (provider, model) (increase(fluxnova_llm_cost_total{workflow=~\"$workflow\", task=~\"$agent_task\"}[5m]))",
          "legendFormat": "{{provider}} / {{model}}",
          "refId": "A"
        }
      ],
      "title": "Estimated LLM cost (5m increase)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["fluxnova", "ai", "mi-4", "tokenomics"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "includeAll": true,
        "label": "Workflow",
        "multi": true,
        "name": "workflow",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "LoanApprovalProcess_AI", "value": "LoanApprovalProcess_AI" }
        ],
        "query": "LoanApprovalProcess_AI",
        "type": "custom"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "includeAll": true,
        "label": "Agent task",
        "multi": true,
        "name": "agent_task",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "AgentTask_CreditRisk", "value": "AgentTask_CreditRisk" },
          { "selected": false, "text": "document-intelligence", "value": "document-intelligence" }
        ],
        "query": "AgentTask_CreditRisk,document-intelligence",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Observability",
  "uid": "fluxnova-ai-observability",
  "version": 1
}
