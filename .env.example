# Required for LLM calls
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: pin plugins source (unmerged branch is the default)
PLUGINS_REPO=https://github.com/finos/fluxnova-plugins.git
PLUGINS_REF=llm-token-usage

# Optional JVM tuning for the app container
JAVA_OPTS=-Xms512m -Xmx1024m

# Local state-009 ingress: replace 18080 with its published HOST port.
# Backend runs in Docker; browser uses localhost. No automatic public fallback.
TRADERX_BASE_URL=http://host.docker.internal:18080
TRADERX_PUBLIC_URL=http://localhost:18080
# Explicit public-demo alternative (writes affect the shared demo):
# TRADERX_BASE_URL=https://demo-advanced.traderx.finos.org
# TRADERX_PUBLIC_URL=https://demo-advanced.traderx.finos.org
